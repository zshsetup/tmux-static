[submodule "vendor/tmux"]
    path = vendor/tmux
    url = https://github.com/tmux/tmux.git
    shallow = true
[submodule "vendor/libevent"]
    path = vendor/libevent
    url = https://github.com/libevent/libevent.git
    shallow = true
[submodule "vendor/ncurses"]
    path = vendor/ncurses
    url = https://github.com/ThomasDickey/ncurses-snapshots.git
    shallow = true
[submodule "vendor/jemalloc"]
    path = vendor/jemalloc
    url = https://github.com/jemalloc/jemalloc.git
    shallow = true
